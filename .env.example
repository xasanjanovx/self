TELEGRAM_BOT_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DB_TABLE_PREFIX=
# Gemini работает только через Google Cloud Vertex AI (с 09.10 AI Studio отключён):
VERTEX_API_KEY=
# номер проекта Google Cloud (нужен живому голосу); пусто — бот узнаёт его сам по ответу Vertex
VERTEX_PROJECT=
# Ключ Google AI Studio больше не нужен. Вернуть AI Studio (откат при сбое Vertex, бесплатный ключ) — ALLOW_AI_STUDIO=1 и GEMINI_API_KEY.
GEMINI_API_KEY=
ALLOW_AI_STUDIO=

GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash
# «Джарвис»: модель агента (по умолчанию = GEMINI_MODEL) и бюджет размышлений (0 = быстрее)
AGENT_MODEL=
AGENT_THINKING_BUDGET=0

APP_TIMEZONE=Asia/Tashkent
DEFAULT_CURRENCY=UZS
DEFAULT_LANGUAGE=ru

# Личный бот: список Telegram ID через запятую. Пусто = пускать всех.
ALLOWED_TELEGRAM_IDS=

# Необязательно: канал для кнопки «Опубликовать» (бот должен быть админом), напр. @ishdasiz
VACANCY_CHANNEL=
VACANCY_FOOTER_URL=https://t.me/ishdasiz

WEEKLY_REPORT_CHECK_SECONDS=1800
WEEKLY_REPORT_HOUR=20
WEEKLY_REPORT_MINUTE=0
